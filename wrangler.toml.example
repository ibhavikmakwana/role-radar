# ==============================================================================
# RoleRadar - Cloudflare Pages Configuration Template
# Rename this file to wrangler.toml for Cloudflare Pages deployment
# ==============================================================================

name = "role-radar"
pages_build_output_dir = "public"
compatibility_date = "2024-09-01"

# KV Namespace Binding for Shortlist Storage (Optional)
# [[kv_namespaces]]
# binding = "SHORTLIST_KV"
# id = "YOUR_KV_NAMESPACE_ID"
